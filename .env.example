# ========================================================
# Potato Application Environment Configuration Example
# ========================================================
# Copy this file to .env before starting the services

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=potato_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=potato_secure_password_123
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/potato_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=potato_secure_password_123

# Redis Configuration (Redis 7)
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Server Configuration
PORT=8080
SERVER_PORT=8080

# Security / JWT Configuration
# 256-bit Hexadecimal secret key for HMAC-SHA256
JWT_SECRET=4c653066613337626130386134376435386237613563636531326462613963383832393366623631623832353361366166303233383437346663363435343461
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=5173
